{
  "name": "contexa",
  "version": "0.3.0",
  "description": "Browse and lint AI context files in a repo via a local web UI",
  "type": "module",
  "bin": {
    "contexa": "./bin/contexa.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "criteria",
    ".output",
    "shared",
    "app",
    "server",
    "public",
    "nuxt.config.ts",
    "content.config.ts",
    "tsconfig.json",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "dev": "node bin/contexa.mjs dev",
    "dev:sample": "node bin/contexa.mjs dev ./fixtures/sample-repo",
    "build": "nuxt build",
    "prepack": "nuxt build",
    "start": "node bin/contexa.mjs start",
    "start:sample": "node bin/contexa.mjs start ./fixtures/sample-repo",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "prepare": "node ./scripts/prepare.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "context",
    "agents",
    "lint",
    "markdown",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@nuxt/content": "^3.16.0",
    "better-sqlite3": "^13.0.3",
    "nuxt": "^4.5.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "yaml": "^2.9.1"
  }
}
